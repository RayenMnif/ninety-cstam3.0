<Window x:Class="NinetyAgent.Client.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NinetyAgent - Gaming Portal"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#040407"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

	<Window.Resources>
		<!-- Dynamic Neon Pulse Animation for Background Orbs -->
		<Storyboard x:Key="PulseGlowStoryboard" RepeatBehavior="Forever" AutoReverse="True">
			<DoubleAnimation Storyboard.TargetName="OrbCyan" Storyboard.TargetProperty="Opacity" From="0.25" To="0.55" Duration="0:0:3"/>
			<DoubleAnimation Storyboard.TargetName="OrbPurple" Storyboard.TargetProperty="Opacity" From="0.20" To="0.45" Duration="0:0:4"/>
		</Storyboard>

		<!-- Modern High-Tech Input Box Template (TextBox) -->
		<Style x:Key="CyberTextBoxStyle" TargetType="TextBox">
			<Setter Property="Background" Value="#0F0F18"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#252538"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Padding" Value="16,12"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
							<ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="BorderBrush" Value="#00F0FF"/>
								<Setter TargetName="border" Property="Background" Value="#141422"/>
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="border" Property="BorderBrush" Value="#00F0FF"/>
								<Setter TargetName="border" Property="Background" Value="#17172A"/>
								<Setter TargetName="border" Property="Effect">
									<Setter.Value>
										<DropShadowEffect Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
									</Setter.Value>
								</Setter>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Modern High-Tech Input Box Template (PasswordBox) -->
		<Style x:Key="CyberPasswordStyle" TargetType="PasswordBox">
			<Setter Property="Background" Value="#0F0F18"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#252538"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Padding" Value="16,12"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="PasswordBox">
						<Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
							<ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="BorderBrush" Value="#00F0FF"/>
								<Setter TargetName="border" Property="Background" Value="#141422"/>
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="border" Property="BorderBrush" Value="#00F0FF"/>
								<Setter TargetName="border" Property="Background" Value="#17172A"/>
								<Setter TargetName="border" Property="Effect">
									<Setter.Value>
										<DropShadowEffect Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
									</Setter.Value>
								</Setter>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- High Energy Neon Gradient Action Button -->
		<Style x:Key="CyberGlowButtonStyle" TargetType="Button">
			<Setter Property="Foreground" Value="#000000"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="UltraBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="btnBorder" CornerRadius="10">
							<Border.Background>
								<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
									<GradientStop Color="#00F0FF" Offset="0.0"/>
									<GradientStop Color="#7000FF" Offset="1.0"/>
								</LinearGradientBrush>
							</Border.Background>
							<Border.Effect>
								<DropShadowEffect Color="#00F0FF" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
								<ContentPresenter.Resources>
									<Style TargetType="TextBlock">
										<Setter Property="Foreground" Value="#FFFFFF"/>
									</Style>
								</ContentPresenter.Resources>
							</ContentPresenter>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="btnBorder" Property="Effect">
									<Setter.Value>
										<DropShadowEffect Color="#00F0FF" BlurRadius="28" ShadowDepth="0" Opacity="0.9"/>
									</Setter.Value>
								</Setter>
								<Setter TargetName="btnBorder" Property="Background">
									<Setter.Value>
										<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
											<GradientStop Color="#33F3FF" Offset="0.0"/>
											<GradientStop Color="#A000FF" Offset="1.0"/>
										</LinearGradientBrush>
									</Setter.Value>
								</Setter>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="btnBorder" Property="Effect">
									<Setter.Value>
										<DropShadowEffect Color="#7000FF" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
									</Setter.Value>
								</Setter>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Segmented Tab Switcher Style -->
		<Style x:Key="CyberTabStyle" TargetType="RadioButton">
			<Setter Property="Foreground" Value="#707088"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border x:Name="tabBorder" Background="Transparent" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="tabBorder" Property="Background" Value="#1E1E2E"/>
								<Setter Property="Foreground" Value="#00F0FF"/>
								<Setter TargetName="tabBorder" Property="Effect">
									<Setter.Value>
										<DropShadowEffect Color="#00F0FF" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
									</Setter.Value>
								</Setter>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Foreground" Value="#FFFFFF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Animated Form Panels (Smooth Slide + Fade) -->
		<Style x:Key="AnimatedFormPanel" TargetType="StackPanel">
			<Setter Property="RenderTransform">
				<Setter.Value>
					<TranslateTransform Y="0"/>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="Visibility" Value="Visible">
					<Trigger.EnterActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
								<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.35">
									<DoubleAnimation.EasingFunction>
										<CubicEase EasingMode="EaseOut"/>
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</Trigger.EnterActions>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Window.Triggers>
		<EventTrigger RoutedEvent="Loaded">
			<BeginStoryboard Storyboard="{StaticResource PulseGlowStoryboard}"/>
		</EventTrigger>
	</Window.Triggers>

	<!-- Canvas Fullscreen Stage -->
	<Grid>
		<!-- 1. Ambient Background Neon Glow Orbs -->
		<Ellipse x:Name="OrbCyan" Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-250,-250,0,0" Opacity="0.35">
			<Ellipse.Fill>
				<RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5">
					<GradientStop Color="#00F0FF" Offset="0"/>
					<GradientStop Color="#00000000" Offset="0.8"/>
				</RadialGradientBrush>
			</Ellipse.Fill>
		</Ellipse>

		<Ellipse x:Name="OrbPurple" Width="1000" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-300" Opacity="0.30">
			<Ellipse.Fill>
				<RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5">
					<GradientStop Color="#8A00FF" Offset="0"/>
					<GradientStop Color="#00000000" Offset="0.8"/>
				</RadialGradientBrush>
			</Ellipse.Fill>
		</Ellipse>

		<!-- 2. Screen Ambient HUD Branding Corner Elements -->
		<StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,35,0,0" Orientation="Horizontal">
			<Border Width="12" Height="12" CornerRadius="6" Background="#00F0FF" VerticalAlignment="Center" Margin="0,0,12,0">
				<Border.Effect>
					<DropShadowEffect Color="#00F0FF" BlurRadius="12" ShadowDepth="0"/>
				</Border.Effect>
			</Border>
			<TextBlock Text="NINETY AGENT OS" Foreground="#A0A0C0" FontSize="14" FontWeight="Bold" />
		</StackPanel>

		<StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,35,40,0" Orientation="Horizontal">
			<TextBlock Text="SYSTEM STATUS: " Foreground="#505068" FontSize="12" FontWeight="SemiBold"/>
			<TextBlock Text="ONLINE" Foreground="#00FF66" FontSize="12" FontWeight="Bold"/>
		</StackPanel>

		<!-- 3. Central Login Card -->
		<Border Width="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#0B0B12"
                CornerRadius="20"
                BorderThickness="1.5">
			<Border.BorderBrush>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Color="#00F0FF" Offset="0.0"/>
					<GradientStop Color="#202035" Offset="0.5"/>
					<GradientStop Color="#A000FF" Offset="1.0"/>
				</LinearGradientBrush>
			</Border.BorderBrush>

			<Border.Effect>
				<DropShadowEffect Color="#000000" BlurRadius="60" ShadowDepth="0" Opacity="0.9"/>
			</Border.Effect>

			<!-- Card Zoom Entrance Animation -->
			<Border.Triggers>
				<EventTrigger RoutedEvent="Loaded">
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
							<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.88" To="1" Duration="0:0:0.45">
								<DoubleAnimation.EasingFunction>
									<BackEase EasingMode="EaseOut" Amplitude="0.3"/>
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
							<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.88" To="1" Duration="0:0:0.45">
								<DoubleAnimation.EasingFunction>
									<BackEase EasingMode="EaseOut" Amplitude="0.3"/>
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</EventTrigger>
			</Border.Triggers>

			<Border.RenderTransform>
				<ScaleTransform ScaleX="1" ScaleY="1" CenterX="250" CenterY="280"/>
			</Border.RenderTransform>

			<Grid Margin="40">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<!-- Title / Header -->
					<RowDefinition Height="Auto"/>
					<!-- Mode Selector -->
					<RowDefinition Height="*"/>
					<!-- Input Forms -->
					<RowDefinition Height="Auto"/>
					<!-- Status & Exit -->
				</Grid.RowDefinitions>

				<!-- Header Section -->
				<StackPanel Grid.Row="0" Margin="0,0,0,28" HorizontalAlignment="Center">
					<TextBlock Text="NINETY AGENT" Foreground="#FFFFFF" FontSize="26" FontWeight="Black"  HorizontalAlignment="Center"/>
					<TextBlock Text="GAMER STATION PORTAL" Foreground="#00F0FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
				</StackPanel>

				<!-- Mode Selector (Login / Register Tabs) -->
				<Border Grid.Row="1" Background="#12121D" CornerRadius="10" Padding="4" Margin="0,0,0,28" BorderBrush="#202030" BorderThickness="1">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<RadioButton x:Name="RadioLogin" Grid.Column="0" Content="LOGIN" IsChecked="True"
                                     Style="{StaticResource CyberTabStyle}" Height="42" Checked="TabMode_Changed"/>

						<RadioButton x:Name="RadioRegister" Grid.Column="1" Content="REGISTER" IsChecked="False"
                                     Style="{StaticResource CyberTabStyle}" Height="42" Checked="TabMode_Changed"/>
					</Grid>
				</Border>

				<!-- Forms Container -->
				<Grid Grid.Row="2">
					<!-- LOGIN FORM -->
					<StackPanel x:Name="PanelLogin" Visibility="Visible" Style="{StaticResource AnimatedFormPanel}">
						<TextBlock Text="ACCOUNT USERNAME OR EMAIL" Foreground="#8080A0" FontSize="11" FontWeight="Bold"  Margin="0,0,0,8"/>
						<TextBox x:Name="TxtLoginUser" Height="48" Style="{StaticResource CyberTextBoxStyle}"/>

						<TextBlock Text="PASSWORD" Foreground="#8080A0" FontSize="11" FontWeight="Bold"  Margin="0,18,0,8"/>
						<PasswordBox x:Name="TxtLoginPassword" Height="48" Style="{StaticResource CyberPasswordStyle}"/>

						<Button x:Name="BtnSubmitLogin" Content="CONNECT TO SESSION" Height="50" Margin="0,30,0,0"
                                Style="{StaticResource CyberGlowButtonStyle}" Click="BtnSubmitLogin_Click"/>
					</StackPanel>

					<!-- REGISTER FORM -->
					<StackPanel x:Name="PanelRegister" Visibility="Collapsed" Style="{StaticResource AnimatedFormPanel}">
						<TextBlock Text="USERNAME" Foreground="#8080A0" FontSize="11" FontWeight="Bold"  Margin="0,0,0,8"/>
						<TextBox x:Name="TxtRegUser" Height="48" Style="{StaticResource CyberTextBoxStyle}"/>

						<TextBlock Text="EMAIL ADDRESS" Foreground="#8080A0" FontSize="11" FontWeight="Bold"  Margin="0,14,0,8"/>
						<TextBox x:Name="TxtRegEmail" Height="48" Style="{StaticResource CyberTextBoxStyle}"/>

						<TextBlock Text="PASSWORD" Foreground="#8080A0" FontSize="11" FontWeight="Bold" Margin="0,14,0,8"/>
						<PasswordBox x:Name="TxtRegPassword" Height="48" Style="{StaticResource CyberPasswordStyle}"/>

						<Button x:Name="BtnSubmitRegister" Content="CREATE GAMER ACCOUNT" Height="50" Margin="0,26,0,0"
                                Style="{StaticResource CyberGlowButtonStyle}" Click="BtnSubmitRegister_Click"/>
					</StackPanel>
				</Grid>

				<!-- Status & Exit Action Footer -->
				<StackPanel Grid.Row="3" Margin="0,22,0,0">
					<TextBlock x:Name="TxtStatus" Text="" Foreground="#FF3366" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>

					<Button Content="✕ EXIT APPLICATION" Background="Transparent" Foreground="#606078" FontSize="12" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Click="BtnExit_Click" HorizontalAlignment="Center">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<TextBlock x:Name="txtExit" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="txtExit" Property="Foreground" Value="#FF3366"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>