<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
	</ItemGroup>

	<!-- Automatically build the Client project before Watchdog builds -->
	<ItemGroup>
		<ProjectReference Include="..\NinetyAgent.Client\NinetyAgent.Client.csproj" />
	</ItemGroup>

	<!-- Auto-copy built Client binaries into Watchdog's Client/ output directory -->
	<Target Name="CopyClientToWatchdog" AfterTargets="Build">
		<ItemGroup>
			<ClientFiles Include="..\NinetyAgent.Client\bin\$(Platform)\$(Configuration)\net8.0-windows\**\*.*" />
		</ItemGroup>

		<!-- Copy all dependencies to Client folder -->
		<Copy SourceFiles="@(ClientFiles)" DestinationFolder="$(TargetDir)Client\%(RecursiveDir)" SkipUnchangedFiles="true" />

		<!-- Copy executable and alias it as NinetyAgent.exe -->
		<Copy SourceFiles="..\NinetyAgent.Client\bin\$(Platform)\$(Configuration)\net8.0-windows\NinetyAgent.Client.exe"
		      DestinationFiles="$(TargetDir)Client\NinetyAgent.exe"
		      SkipUnchangedFiles="true"
		      Condition="Exists('..\NinetyAgent.Client\bin\$(Platform)\$(Configuration)\net8.0-windows\NinetyAgent.Client.exe')" />
	</Target>
</Project>